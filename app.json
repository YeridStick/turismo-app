{
  "expo": {
    "name": "turismo-app",
    "slug": "turismo-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Necesitamos la cámara para mostrar experiencias de realidad aumentada.",
        "NSLocationWhenInUseUsageDescription": "Necesitamos tu ubicación para mostrarte sitios turísticos cercanos en el mapa."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.yeridstick.turismoapp",
      "permissions": [
        "CAMERA",
        "android.permission.INTERNET",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "@reactvision/react-viro",
        {
          "cameraPermission": "Esta aplicación necesita acceso a la cámara para mostrar realidad aumentada."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permite que $(PRODUCT_NAME) use tu ubicación para mostrarte sitios turísticos cercanos.",
          "locationWhenInUsePermission": "Permite que $(PRODUCT_NAME) use tu ubicación para mostrarte sitios turísticos cercanos."
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "newArchEnabled": true,
    "extra": {
      "eas": {
        "projectId": "0c45beb3-fc9d-4dd1-bfc8-81c23d084c9c"
      }
    }
  }
}